<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>SnipShot</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\snipshot.ico" />
    <!--
      El arte original (1080x1080) se conserva en el repo para poder regenerar los iconos,
      pero Windows no lo usa: sin este Remove el glob de Content lo mete en el MSIX y son
      400 KB muertos en cada paquete.
    -->
    <Content Remove="Assets\logo-snipshot-app.png" />
    <None Include="Assets\logo-snipshot-app.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <!-- H.NotifyIcon.WinUI eliminado - causaba alto consumo de CPU. Usando Shell_NotifyIcon nativo. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
  </ItemGroup>

  <!--
    El CLI (comando snipshot) viaja dentro del mismo paquete MSIX. La referencia solo sirve
    para que su ejecutable acabe en la salida que se empaqueta; la app no usa su código.

    Comparte el runtime autocontenido de la app, y el trimming de Release borra todo lo que
    la app no usa: SnipShot.Cli.dll, System.Console, System.IO.Pipes... Declararlo raíz hace
    que ILLink lo conserve junto con las partes del runtime de las que depende.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SnipShot.Cli\SnipShot.Cli.csproj" />
    <TrimmerRootAssembly Include="SnipShot.Cli" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <!--
      IL2104 lo emiten WinRT.Runtime y Microsoft.Windows.SDK.NET, ensamblados del Windows App
      SDK que no controlamos. Se silencia solo ese codigo, en vez de SuppressTrimAnalysisWarnings,
      para que el analisis siga vigilando el codigo propio: hoy no produce ningun aviso y hay que
      enterarse si algun cambio futuro introduce reflexion que el trimming pueda romper.
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <!--
      Sin sello de tiempo, un paquete deja de poder instalarse el día que caduca el certificado.
      Con él sigue siendo válido, porque la firma se comprueba contra la fecha en que se hizo.
    -->
    <AppxPackageSigningTimestampServerUrl>http://timestamp.digicert.com</AppxPackageSigningTimestampServerUrl>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64|arm64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <!--
      Se firma con el certificado instalado en Cert:\CurrentUser\My, no con un .pfx dentro del
      proyecto: así la clave no vive junto al código y la compilación no pide contraseña. La copia
      de seguridad con contraseña se guarda fuera del repositorio.
    -->
    <PackageCertificateThumbprint>FBDFD845E02CE1A9BD786A47A3E8681B4776C2FA</PackageCertificateThumbprint>
  </PropertyGroup>
</Project>