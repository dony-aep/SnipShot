<?xml version="1.0" encoding="utf-8"?>
<base:CaptureModeBase
    x:Class="SnipShot.Features.Capture.Modes.WindowCapture.WindowCaptureControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:SnipShot.Features.Capture.Modes.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          PointerMoved="RootGrid_PointerMoved"
          PointerPressed="RootGrid_PointerPressed">
        
        <!-- KeyboardAccelerator para Esc (funciona sin importar el foco) -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked"/>
        </Grid.KeyboardAccelerators>
        
        <Canvas>
            <!-- Shades para resaltar ventana seleccionada -->
            <Rectangle x:Name="TopShade"
                       Fill="#40000000"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
            <Rectangle x:Name="BottomShade"
                       Fill="#40000000"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
            <Rectangle x:Name="LeftShade"
                       Fill="#40000000"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
            <Rectangle x:Name="RightShade"
                       Fill="#40000000"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>

            <Border x:Name="HighlightBorder"
                    Visibility="Collapsed"
                    BorderBrush="White"
                    BorderThickness="1.5"
                    Background="Transparent"
                    CornerRadius="2"
                    IsHitTestVisible="False"/>
            
            <!-- Menú Flotante de Captura (por encima de todo) -->
            <Border x:Name="CaptureFloatingMenu"
                    Visibility="Visible"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Translation="0,0,32"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Menú desplegable de modos -->
                    <Button x:Name="CaptureModeButton" AutomationProperties.AutomationId="CaptureModeButton" AutomationProperties.Name="Modo de captura"
                           ToolTipService.ToolTip="Modo de captura"
                           Click="CaptureModeButton_Click"
                           MinWidth="68" Height="34" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="CaptureModeIcon" Glyph="&#xF7ED;" FontSize="16" Foreground="{ThemeResource OverlayTextBrush}"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="11" Foreground="{ThemeResource OverlayTextBrush}"/>
                        </StackPanel>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- SelectedIndex apunta al modo de este overlay, así que el
                                     SelectionChanged que dispara al cargar cae en la rama no-op -->
                                <ListView x:Name="CaptureModeList" AutomationProperties.AutomationId="CaptureModeList"
                                          SelectedIndex="1"
                                          IsItemClickEnabled="True"
                                          ItemClick="CaptureModeList_ItemClick"
                                          SelectionChanged="CaptureModeList_SelectionChanged">
                                    <ListViewItem Tag="Rectangular">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF407;" FontSize="16"/>
                                            <TextBlock Text="Rectangular"/>
                                        </StackPanel>
                                    </ListViewItem>

                                    <ListViewItem Tag="Ventana">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF7ED;" FontSize="16"/>
                                            <TextBlock Text="Ventana"/>
                                        </StackPanel>
                                    </ListViewItem>

                                    <ListViewItem Tag="Pantalla Completa">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE9A6;" FontSize="16"/>
                                            <TextBlock Text="Pantalla Completa"/>
                                        </StackPanel>
                                    </ListViewItem>

                                    <ListViewItem Tag="Forma Libre">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF408;" FontSize="16"/>
                                            <TextBlock Text="Forma Libre"/>
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Button>
                    
                    <!-- Botón selector de color -->
                    <Button x:Name="ColorPickerButton" AutomationProperties.AutomationId="ColorPickerButton" AutomationProperties.Name="Selector de Color"
                           Click="ColorPickerButton_Click"
                           ToolTipService.ToolTip="Selector de Color"
                           Width="34" Height="34" Padding="0">
                        <FontIcon Glyph="&#xEF3C;" FontSize="16" Foreground="{ThemeResource OverlayTextBrush}"/>
                    </Button>
                    
                    <Border Width="1" 
                           Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                           Margin="3,7"/>
                    
                    <!-- Botón cerrar -->
                    <Button x:Name="FloatingCloseButton" AutomationProperties.AutomationId="FloatingCloseButton" AutomationProperties.Name="Cerrar (ESC)"
                           Click="FloatingClose_Click"
                           ToolTipService.ToolTip="Cerrar (ESC)"
                           Width="34" Height="34" Padding="0">
                        <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource OverlayTextBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</base:CaptureModeBase>
