<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Debe coincidir con el TFM de SnipShot para poder referenciarlo. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- SnipShot es WinExe con empaquetado MSIX; nada de eso debe heredarse aquí. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <!--
    No se referencia SnipShot.csproj a proposito. El Windows App SDK inyecta un module
    initializer en SnipShot.dll que arranca el Windows App Runtime al cargar el ensamblado,
    y fuera de un contexto empaquetado falla con REGDB_E_CLASSNOTREG antes de que llegue a
    ejecutarse ninguna prueba.

    En su lugar se compilan aqui las fuentes de logica pura, que no dependen de WinUI ni del
    Windows App SDK. Cuando se extraiga esa logica a una libreria propia (SnipShot.Core),
    esto se sustituye por una ProjectReference normal.
  -->
  <ItemGroup>
    <Compile Include="..\SnipShot\Services\UpdateService.cs" Link="Fuentes\UpdateService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
